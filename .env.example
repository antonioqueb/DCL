# Variables de entorno de ejemplo (sin secretos). Copie a .env o defínalas en el servicio.
PORT=4300                 # puerto del servidor de operación (la demostración usa 4310)
HOST=127.0.0.1            # 0.0.0.0 para atender la red local detrás de un proxy con HTTPS
DCL_DATA_DIR=var/operacion  # carpeta de datos de OPERACIÓN (fuera del código público; con respaldo)
DCL_DEMO_DIR=var/demo       # carpeta de la DEMOSTRACIÓN (nunca la misma que la de operación)
DCL_SECURE_COOKIES=0      # 1 cuando se publica con HTTPS
DCL_MAX_UPLOAD_MB=25      # tamaño máximo por archivo
DCL_KEEP_GENERATIONS=10   # versiones recuperables que se conservan
# Solo para la configuración inicial no interactiva (npm run setup); no las deje definidas después:
# DCL_ADMIN_USER=direccion
# DCL_ADMIN_NAME=Nombre de la persona
# DCL_ADMIN_PASSWORD=
