{
  "name": "dcl-operacion",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma operativa de DCL Instalaciones (modo de archivos, sin base de datos)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "demo": "node server/index.js --demo",
    "demo:reset": "node scripts/demo-reset.js",
    "setup": "node scripts/setup.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "export": "node scripts/export-package.js",
    "docs:data": "node scripts/gen-docs.js",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.17.2"
  }
}
